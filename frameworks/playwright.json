{
  "name": "playwright",
  "install": ["npm ci", "npx playwright install --with-deps"],
  "run": "npx playwright test --reporter=junit",
  "env": { "PLAYWRIGHT_JUNIT_OUTPUT_NAME": "results/junit.xml" },
  "report_glob": "results/*.xml",
  "error_context_glob": "test-results/**/error-context.md",
  "test_glob": "tests/**/*.spec.ts",
  "default_test_dir": "tests",
  "locator_priority": ["getByRole", "getByLabel", "getByPlaceholder", "getByText", "getByTestId"],
  "forbidden_paths": ["src/"],
  "agents_dir": "agents/playwright",
  "mcp": "browser"
}
